{
  "images": {
    "sizes": [
      320,
      480,
      640,
      828,
      1080,
      1200,
      1600,
      1920
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "images.boatsgroup.com"
      },
      {
        "protocol": "https",
        "hostname": "imt.boatwizard.com"
      },
      {
        "protocol": "https",
        "hostname": "s3.amazonaws.com"
      },
      {
        "protocol": "https",
        "hostname": "cdn.yachtbroker.org"
      },
      {
        "protocol": "https",
        "hostname": "fyiyachts.com"
      },
      {
        "protocol": "https",
        "hostname": "storage.googleapis.com"
      },
      {
        "protocol": "https",
        "hostname": "miamicharters.com"
      },
      {
        "protocol": "https",
        "hostname": "miamiyachtconnect.com"
      }
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 86400
  },
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hero/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://fyiyachts.com"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/charter/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/site-photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/app/team/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/news/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/thank-you",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/scanner-blocked.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(wp-.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.php)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(\\.env.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(\\.git.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap-listings.xml",
      "destination": "/api/sitemap-listings"
    },
    {
      "source": "/listing/:id",
      "destination": "/api/listing?id=:id"
    },
    {
      "source": "/yacht/:slug([a-z0-9-]*[a-z][a-z0-9-]*)",
      "destination": "/api/yacht-redirect?slug=:slug"
    },
    {
      "source": "/yacht-listing/:slug([a-z0-9-]*[a-z][a-z0-9-]*)",
      "destination": "/api/yacht-redirect?slug=:slug"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/brianna",
      "destination": "/index.html"
    },
    {
      "source": "/quiz",
      "destination": "/index.html"
    },
    {
      "source": "/thank-you",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/404",
      "destination": "/index.html"
    },
    {
      "source": "/(wp-.*)",
      "destination": "/scanner-blocked.txt"
    },
    {
      "source": "/(.*\\.php)",
      "destination": "/scanner-blocked.txt"
    },
    {
      "source": "/(\\.env.*)",
      "destination": "/scanner-blocked.txt"
    },
    {
      "source": "/(\\.git.*)",
      "destination": "/scanner-blocked.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/api/not-found"
    }
  ],
  "crons": [
    {
      "path": "/api/alerts/check",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/classify-notes",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/price-snapshot",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/enrich-lead-sizes",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/seo-sync",
      "schedule": "15 6 * * *"
    }
  ],
  "trailingSlash": false,
