# FYI Yachts website — environment variables.
# Set these in the Vercel project (Settings → Environment Variables).
# Anything left unset simply switches its feature off; nothing falls back to a
# built-in credential.

# ---- Core ---------------------------------------------------------------
# Public site origin, used for canonicals, sitemaps and absolute links.
SITE_URL=https://fyiyachts.com
# Signs portal login sessions. Any long random string.
AUTH_SECRET=
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ---- Inventory ----------------------------------------------------------
# FYI's BoatsGroup (boats.com) inventory search API key. Drives every listing
# page, the sitemap, Brianna's inventory answers and price snapshots.
BOATS_API_KEY=

# ---- Email (SMTP) -------------------------------------------------------
# Lead notifications, login codes and market-alert emails.
SMTP_USER=
SMTP_PASS=

# ---- HubSpot (FYI portal) ----------------------------------------------
# Private-app token. Lead capture (forms, Brianna, phone), admin dashboards.
HUBSPOT_ACCESS_TOKEN=
# Optional: market-alert subscriber sync. Leave unset to keep it off.
FYI_HUBSPOT_PAT=
FYI_HUBSPOT_SUBSCRIBER_PROPERTY=
FYI_HUBSPOT_SUBSCRIBER_LIST_ID=
FYI_HUBSPOT_BRAND_PROPERTY=

# ---- Brianna chatbot ----------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- AI phone receptionist (ElevenLabs + Twilio) -----------------------
VOICE_WEBHOOK_SECRET=
ELEVENLABS_POSTCALL_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: comma-separated transfer destinations known to drop callers.
VOICE_FLAKY_DESTINATIONS=

# ---- Saved boats, price alerts, portal profiles ------------------------
# Upstash Redis / Vercel KV.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Signs one-click unsubscribe links in alert emails.
ALERTS_UNSUBSCRIBE_SECRET=
# Supabase: portal users (`market_alert_recipients`) and Search Console
# snapshots (`gsc_snapshots`). Service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Search Console / GA4 (admin SEO + reports) -----------------------
# Google service-account key (raw JSON or base64). Add the service account in
# Search Console (Users and permissions) and as a GA4 property Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
VITE_GA4_ID=

# ---- Optional ---------------------------------------------------------
# IndexNow key (public by design; served at /<key>.txt). Unset uses the
# committed default.
INDEXNOW_KEY=
# Semantic search (Pinecone). Off unless both are set.
PINECONE_API_KEY=
PINECONE_HOST=
CORS_ORIGIN=
